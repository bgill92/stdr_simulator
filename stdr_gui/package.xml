<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stdr_gui</name>
  <version>1.0.0</version>
  <description>ImGui-based GUI library for STDR Simulator with no ROS dependencies.</description>

  <maintainer email="bilal@todo.com">Bilal Gill</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>stdr_simulation</depend>
  <build_depend>imgui</build_depend>
  <build_depend>implot</build_depend>
  <build_depend>libgl-devel</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
