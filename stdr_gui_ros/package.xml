<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stdr_gui_ros</name>
  <version>1.0.0</version>
  <description>ROS2 GUI node for STDR simulator — thin wrapper around stdr_gui using ROS2 topics and services.</description>

  <maintainer email="bilal@todo.com">Bilal Gill</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>stdr_gui</depend>
  <depend>stdr_simulation</depend>
  <depend>stdr_msgs</depend>
  <depend>stdr_parser</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tl_expected</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
