<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stdr_server</name>
  <version>1.0.0</version>
  <description>Central ROS2 server node for the STDR Simulator. Manages the world model, robot lifecycle, map loading, and environment sources.</description>

  <maintainer email="bilal@todo.com">Bilal Gill</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>stdr_msgs</depend>
  <depend>stdr_simulation</depend>
  <depend>stdr_parser</depend>
  <depend>tl_expected</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
