<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stdr_standalone</name>
  <version>1.0.0</version>
  <description>Standalone STDR simulator executable with no ROS dependencies.</description>

  <maintainer email="bilal@todo.com">Bilal Gill</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>stdr_simulation</depend>
  <depend>stdr_gui</depend>
  <depend>tl_expected</depend>
  <build_depend>libpng</build_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
